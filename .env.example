# Copier ce fichier en .env (jamais commité) et remplir les valeurs.
# Mot de passe PostgreSQL local (docker compose)
POSTGRES_PASSWORD=
# Production : variables lues par ASP.NET Core (le double souligné remplace « : »)
ConnectionStrings__TradX=
Jwt__SigningKey=
Cors__AllowedOrigins__0=
# Démonstration (réglage par défaut) : aucun e-mail, comptes utilisables dès l'inscription.
Email__Mode=Disabled
Auth__RequireEmailConfirmation=false
# Vrai lancement : décommenter et remplir (envoi SMTP + confirmation d'adresse exigée).
# Email__Mode=Smtp
# Auth__RequireEmailConfirmation=true
# Auth__FrontendBaseUrl=
# Email__SmtpHost=
# Email__SmtpUser=
# Email__SmtpPassword=
# Email__From=
