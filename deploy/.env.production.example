# Copier en .env.production à la racine du dépôt (jamais commité) et remplir.
# Domaine qui pointe vers le serveur (enregistrement DNS A/AAAA). « localhost » pour un essai local.
DOMAIN=
# Mot de passe de la base (long et aléatoire). Exemple pour en générer un :  openssl rand -base64 32
POSTGRES_PASSWORD=
# Clé de signature des jetons de session, au moins 32 octets aléatoires :  openssl rand -base64 48
JWT_SIGNING_KEY=
# Facultatif : ce compte (déjà inscrit) devient administrateur au démarrage.
ADMIN_EMAIL=
# Facultatif : ports publiés (80 et 443 par défaut).
# HTTP_PORT=80
# HTTPS_PORT=443
